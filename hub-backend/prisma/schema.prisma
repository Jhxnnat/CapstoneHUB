// docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  proposed
  under_review
  approved
  in_progress
  paused
  closed
  cancelled
  rejected
}

enum UserRole {
  admin
  evaluator
  coordinator
  advisor
  student
  proposer
}

/**
 * Origen de la identidad del usuario: contraseña local o SSO corporativo.
 */
enum AuthProvider {
  local
  microsoft
}

enum ActorRole {
  advisor
  coordinator
  student
  evaluator
}

enum ReportStatus {
  pending
  submitted
  accepted
  rejected
}

enum ReportContentKind {
  text
  link
  image
  video
  file
}

enum ProjectSource {
  external_entity
  research
  internal_need
  social_impact
}

enum ProjectPhase {
  semester_1
  semester_2
}

model User {
  id              Int          @id @default(autoincrement())
  fullName        String       @map("full_name") @db.VarChar(255)
  email           String       @unique(map: "uk_user_email") @db.VarChar(255)
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  authProvider    AuthProvider @default(local) @map("auth_provider")
  entraObjectId   String?      @unique(map: "uk_user_entra_object_id") @map("entra_object_id") @db.VarChar(255)
  isActive        Boolean      @default(true) @map("is_active")
  emailVerifiedAt DateTime?    @map("email_verified_at")
  lastLoginAt     DateTime?    @map("last_login_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  roleAssignments        UserRoleAssignment[]
  projectAssignments     ProjectActorAssignment[]
  projectStatusHistories ProjectStatusHistory[]
  projectChangeHistories ProjectChangeHistory[]
  authoredObservations   ProjectObservation[]
  uploadedAttachments    ProjectAttachment[]
  createdReports         ProjectReport[]          @relation("ReportCreatedBy")
  reviewedReports        ProjectReport[]          @relation("ReportReviewedBy")
  reportContents         ProjectReportContent[]   @relation("ReportContentCreatedBy")
  proposedProjects       Project[]                @relation("ProjectProposedBy")
  phaseApprovals         ProjectPhaseApproval[]

  @@index([fullName], map: "idx_user_full_name")
  @@map("user")
}

model UserRoleAssignment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  role       UserRole
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role], map: "uk_user_role_assignment")
  @@index([userId], map: "idx_user_role_assignment_user_id")
  @@index([role], map: "idx_user_role_assignment_role")
  @@map("user_role_assignment")
}

model Project {
  id                   Int           @id @default(autoincrement())
  name                 String        @db.VarChar(255)
  description          String        @db.Text
  context              String        @db.Text
  location             String?       @db.VarChar(255)
  status               ProjectStatus @default(proposed)
  startDate            DateTime?     @map("start_date")
  endDate              DateTime?     @map("end_date")
  estimatedCost        Decimal?      @map("estimated_cost") @db.Decimal(12, 2)
  requiresLegalization Boolean       @default(false) @map("requires_legalization")
  isPrivate            Boolean       @default(true) @map("is_private")
  source               ProjectSource @default(external_entity)
  phase                ProjectPhase  @default(semester_1)
  facultyAdvisor       String?       @map("faculty_advisor") @db.VarChar(255)
  teamRequirements     String?       @map("team_requirements") @db.Text
  expectedOutcomes     String?       @map("expected_outcomes") @db.Text
  proposerUserId       Int?          @map("proposer_user_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  sourceDetails        String?       @map("source_details") @db.VarChar(250)
  submissionConsentAt  DateTime?     @map("submission_consent_at")

  proposer         User?                    @relation("ProjectProposedBy", fields: [proposerUserId], references: [id], onDelete: SetNull)
  schools          ProjectSchool[]
  naturalProposer  ProjectNaturalProposer?
  actorAssignments ProjectActorAssignment[]
  observations     ProjectObservation[]
  statusHistory    ProjectStatusHistory[]
  milestones       ProjectMilestones[]
  attachments      ProjectAttachment[]
  reports          ProjectReport[]
  deliverables     ProjectDeliverable[]
  changeHistory    ProjectChangeHistory[]
  phaseApprovals   ProjectPhaseApproval[]

  @@index([status], map: "idx_project_status")
  @@index([startDate], map: "idx_project_start_date")
  @@index([createdAt], map: "idx_project_created_at")
  @@index([isPrivate], map: "idx_project_is_private")
  @@index([proposerUserId], map: "idx_project_proposer_user_id")
  @@map("project")
}

model ProjectSchool {
  projectId  Int      @map("project_id")
  schoolName String   @map("school_name") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, schoolName])
  @@index([schoolName], map: "idx_project_school_name")
  @@map("project_school")
}

model ProjectDeliverable {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_project_deliverable_project_id")
  @@map("project_deliverable")
}

model ProjectNaturalProposer {
  projectId Int      @id @map("project_id")
  fullName  String   @map("full_name") @db.VarChar(255)
  idNumber  String?  @map("id_number") @db.VarChar(50)
  email     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([idNumber], map: "idx_project_natural_id_number")
  @@index([email], map: "idx_project_natural_email")
  @@map("project_natural_proposer")
}

model ProjectActorAssignment {
  id         Int       @id @default(autoincrement())
  projectId  Int       @map("project_id")
  userId     Int       @map("user_id")
  role       ActorRole
  assignedAt DateTime  @default(now()) @map("assigned_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId], map: "uk_project_user")
  @@index([projectId], map: "idx_project_user_project_id")
  @@index([userId], map: "idx_project_user_user_id")
  @@index([role], map: "idx_project_actor_role")
  @@map("project_actor_assignment")
}

model ProjectObservation {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  authorUserId Int?     @map("author_user_id")
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorUser User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([projectId], map: "idx_project_observation_project_id")
  @@index([authorUserId], map: "idx_project_observation_author_user_id")
  @@index([createdAt], map: "idx_project_observation_created_at")
  @@map("project_observation")
}

model ProjectStatusHistory {
  id             Int            @id @default(autoincrement())
  projectId      Int            @map("project_id")
  previousStatus ProjectStatus? @map("previous_status")
  nextStatus     ProjectStatus  @map("next_status")
  description    String?        @db.Text
  authorUserId   Int?           @map("author_user_id")
  changedAt      DateTime       @default(now()) @map("changed_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorUser User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([projectId], map: "idx_project_status_history_project_id")
  @@index([nextStatus], map: "idx_project_status_history_next_status")
  @@index([changedAt], map: "idx_project_status_history_changed_at")
  @@map("project_status_history")
}

model ProjectChangeHistory {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  authorUserId  Int?     @map("author_user_id")
  field         String   @db.VarChar(64)
  previousValue String?  @map("previous_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  changedAt     DateTime @default(now()) @map("changed_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorUser User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([projectId], map: "idx_project_change_history_project_id")
  @@index([changedAt], map: "idx_project_change_history_changed_at")
  @@map("project_change_history")
}

model ProjectMilestones {
  id          Int           @id @default(autoincrement())
  projectId   Int           @map("project_id")
  title       String        @db.VarChar(255)
  description String?       @db.Text
  dueDate     DateTime      @map("due_date")
  completed   Boolean       @default(false)
  isMinimum   Boolean       @default(false) @map("is_minimum")
  phase       ProjectPhase?
  createdAt   DateTime      @default(now()) @map("created_at")

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportLinks MilestoneReportLink[]

  @@index([projectId], map: "idx_project_milestones_project_id")
  @@index([dueDate], map: "idx_project_milestones_due_date")
  @@index([completed], map: "idx_project_milestones_completed")
  @@index([isMinimum], map: "idx_project_milestones_is_minimum")
  @@map("project_milestones")
}

model ProjectPhaseApproval {
  id             Int          @id @default(autoincrement())
  projectId      Int          @map("project_id")
  phase          ProjectPhase
  approverUserId Int          @map("approver_user_id")
  approvedAt     DateTime     @default(now()) @map("approved_at")

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approverUser User    @relation(fields: [approverUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, phase, approverUserId], map: "uk_project_phase_approval")
  @@index([projectId], map: "idx_project_phase_approval_project_id")
  @@index([approverUserId], map: "idx_project_phase_approval_approver_user_id")
  @@map("project_phase_approval")
}

model ProjectAttachment {
  id               Int      @id @default(autoincrement())
  projectId        Int      @map("project_id")
  reportId         Int?     @map("report_id")
  uploadedByUserId Int?     @map("uploaded_by_user_id")
  originalName     String   @map("original_name") @db.VarChar(255)
  storageKey       String   @unique(map: "uk_project_attachment_storage_key") @map("storage_key") @db.VarChar(512)
  mimeType         String   @map("mime_type") @db.VarChar(127)
  sizeBytes        Int      @map("size_bytes")
  createdAt        DateTime @default(now()) @map("created_at")

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report     ProjectReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  uploadedBy User?          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  reportContent ProjectReportContent?

  @@index([projectId], map: "idx_project_attachment_project_id")
  @@index([reportId], map: "idx_project_attachment_report_id")
  @@index([uploadedByUserId], map: "idx_project_attachment_uploaded_by_user_id")
  @@index([createdAt], map: "idx_project_attachment_created_at")
  @@map("project_attachment")
}

model ProjectReport {
  id               Int               @id @default(autoincrement())
  projectId        Int               @map("project_id")
  createdByUserId  Int?              @map("created_by_user_id")
  reviewedByUserId Int?              @map("reviewed_by_user_id")
  title            String            @db.VarChar(255)
  description      String?           @db.Text
  dueDate          DateTime          @map("due_date")
  type             ReportContentKind @default(file)
  allowedMimeTypes String[]          @default([]) @map("allowed_mime_types")
  maxFiles         Int?              @map("max_files")
  status           ReportStatus      @default(pending)
  submittedAt      DateTime?         @map("submitted_at")
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewComment    String?           @map("review_comment") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User?                  @relation("ReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy     User?                  @relation("ReportReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  attachments    ProjectAttachment[]
  contents       ProjectReportContent[]
  milestoneLinks MilestoneReportLink[]

  @@index([projectId], map: "idx_project_report_project_id")
  @@index([dueDate], map: "idx_project_report_due_date")
  @@index([status], map: "idx_project_report_status")
  @@index([createdByUserId], map: "idx_project_report_created_by_user_id")
  @@index([reviewedByUserId], map: "idx_project_report_reviewed_by_user_id")
  @@map("project_report")
}

model ProjectReportContent {
  id              Int               @id @default(autoincrement())
  reportId        Int               @map("report_id")
  attachmentId    Int?              @unique(map: "uk_project_report_content_attachment") @map("attachment_id")
  createdByUserId Int?              @map("created_by_user_id")
  kind            ReportContentKind
  textContent     String?           @map("text_content") @db.Text
  url             String?           @db.VarChar(2048)
  label           String?           @db.VarChar(255)
  createdAt       DateTime          @default(now()) @map("created_at")

  report     ProjectReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  attachment ProjectAttachment? @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("ReportContentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([reportId], map: "idx_project_report_content_report_id")
  @@index([kind], map: "idx_project_report_content_kind")
  @@index([createdByUserId], map: "idx_project_report_content_created_by_user_id")
  @@map("project_report_content")
}

model MilestoneReportLink {
  milestoneId Int      @map("milestone_id")
  reportId    Int      @map("report_id")
  createdAt   DateTime @default(now()) @map("created_at")

  milestone ProjectMilestones @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  report    ProjectReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([milestoneId, reportId])
  @@index([reportId], map: "idx_milestone_report_report_id")
  @@index([milestoneId], map: "idx_milestone_report_milestone_id")
  @@map("milestone_report")
}
