DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[db-name]"

AUTH_SECRET="1234567890abcdefhijklmnopqrstuvwxyz"

# Vida del token de acceso, en segundos (86400 = 24 h).
AUTH_TOKEN_TTL_SECONDS="86400"
# Renovación deslizante: se reemite el token al superar esta antigüedad
# (43200 = 12 h por defecto, la mitad de la vida).
AUTH_TOKEN_RENEW_AFTER_SECONDS="43200"

# SSO con Microsoft Entra ID (OIDC). Se activan cuando la universidad entregue
# la app registration; el código de SSO todavía no las lee.
# AZURE_TENANT_ID=""
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""
# AZURE_REDIRECT_URI="http://localhost:3001/auth/sso/callback"
# FRONTEND_URL="http://localhost:3000"
# SSO_ALLOWED_DOMAINS="utb.edu.co"
# SSO_DEFAULT_ROLE="student"

INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-this-password"
INITIAL_ADMIN_NAME="Administrator"

# Project attachments storage
MAX_FILE_SIZE_BYTES="10485760"
# Tope para los archivos de una entrega (100 MB por defecto)
MAX_REPORT_FILE_SIZE_BYTES="104857600"

# Swagger en /api. Pon "false" en producción.
SWAGGER_ENABLED="true"

# Nivel mínimo del log de peticiones: error | warn | log (por defecto) | debug.
# El alias "info" equivale a "log".
LOG_LEVEL="log"

# URL de S3/MinIO que alcanza el navegador; se usa para firmar las subidas
# directas. Sin esta variable las URLs apuntan a S3_ENDPOINT (interno).
S3_PUBLIC_ENDPOINT="http://localhost:9000"
# Vigencia de la URL prefirmada de subida, en segundos (3600 por defecto)
S3_UPLOAD_URL_TTL_SECONDS="3600"

# MinIO (local development)
# S3_ENDPOINT="http://minio:9000"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="capstonehub"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

